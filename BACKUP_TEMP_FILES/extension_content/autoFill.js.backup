// 5c. ASHBY FILL
// ══════════════════════════════════════════════════════════════════
async function fillAshby(profile) {
    console.log('[AutoFill] fillAshby start');
    var p = profile || {};
    var filled = 0;

    var firstName = (p.first_name) || (p.personal && p.personal.first_name) || '';
    var lastName  = (p.last_name)  || (p.personal && p.personal.last_name)  || '';
    var email     = (p.contact && p.contact.email) || p.email || '';
    var phone     = (p.contact && p.contact.phone) || p.phone || '';
    var city      = ((p.contact && p.contact.city) || p.city || '').split(',')[0].trim();
    var linkedin  = (p.social && p.social.linkedin) || p.linkedin || '';
    var portfolio = (p.social && p.social.portfolio) || p.portfolio || '';
    var github    = (p.social && p.social.github) || p.github || '';

    // Ashby uses aria-label matching
    var ariaMap = [
        { ariaLabel: 'First Name', value: firstName },
        { ariaLabel: 'Last Name', value: lastName },
        { ariaLabel: 'Email', value: email },
        { ariaLabel: 'Phone', value: phone },
        { ariaLabel: 'Phone Number', value: phone },
        { ariaLabel: 'City', value: city },
        { ariaLabel: 'Location', value: city },
        { ariaLabel: 'LinkedIn Profile', value: linkedin },
        { ariaLabel: 'LinkedIn URL', value: linkedin },
        { ariaLabel: 'LinkedIn', value: linkedin },
        { ariaLabel: 'Portfolio', value: portfolio },
        { ariaLabel: 'Website', value: portfolio },
        { ariaLabel: 'GitHub', value: github },
        { ariaLabel: 'GitHub Profile', value: github }
    ];

    var allEls = Array.from(document.querySelectorAll('input, textarea'));
    for (var i = 0; i < allEls.length; i++) {
        var el = allEls[i];
        if (!isFieldFillable(el) || fillState.filledElements.has(el)) continue;
        var aria = el.getAttribute('aria-label') || '';
        var match = ariaMap.find(function(m) {
            return aria.toLowerCase() === m.ariaLabel.toLowerCase() ||
                   aria.toLowerCase().includes(m.ariaLabel.toLowerCase());
        });
        if (match && match.value) {
            var ok = fillField(el, match.value);
            if (ok) { fillState.filledElements.add(el); filled++; }
        }
    }

    // Fallback by label text
    var inputs2 = Array.from(document.querySelectorAll('input:not([type="hidden"]), textarea'));
    for (var j = 0; j < inputs2.length; j++) {
        var el2 = inputs2[j];
        if (!isFieldFillable(el2) || fillState.filledElements.has(el2)) continue;
        var lbl = getLabelForElement(el2).toLowerCase();
        var val = '';
        if (/first.?name/i.test(lbl)) val = firstName;
        else if (/last.?name/i.test(lbl)) val = lastName;
        else if (/\bemail\b/i.test(lbl)) val = email;
        else if (/\bphone\b|\bmobile\b/i.test(lbl)) val = phone;
        else if (/\bcity\b|\blocation\b/i.test(lbl)) val = city;
        else if (/linkedin/i.test(lbl)) val = linkedin;
        else if (/portfolio|website/i.test(lbl)) val = portfolio;
        else if (/github/i.test(lbl)) val = github;
        if (val) { fillField(el2, val); fillState.filledElements.add(el2); filled++; }
    }

    if (AUTO_FILL_CONFIG.AI_QUESTIONS_ENABLED) {
        var textareas = Array.from(document.querySelectorAll('textarea'));
        for (var ti = 0; ti < textareas.length; ti++) {
            var ta = textareas[ti];
            if (!isFieldFillable(ta) || fillState.filledElements.has(ta)) continue;
            var taLabel = getLabelForElement(ta);
            if (taLabel && isAIQuestion(taLabel)) {
                var answer = await getAIAnswer(taLabel, profile);
                if (answer) { fillField(ta, answer); fillState.filledElements.add(ta); filled++; }
            }
        }
    }

    console.log('[AutoFill] fillAshby done, filled:', filled);
    return filled;
}

// ══════════════════════════════════════════════════════════════════
// 5d. GOOGLE FORMS FILL
// ══════════════════════════════════════════════════════════════════
async function fillGoogleForms(profile) {
    console.log('[AutoFill] fillGoogleForms start');
    var p = profile || {};
    var filled = 0;

    var firstName = (p.first_name) || (p.personal && p.personal.first_name) || '';
    var lastName  = (p.last_name)  || (p.personal && p.personal.last_name)  || '';
    var email     = (p.contact && p.contact.email) || p.email || '';
    var phone     = (p.contact && p.contact.phone) || p.phone || '';
    var fullName  = (firstName + ' ' + lastName).trim();

    // Google Forms: question headings are in data-params or visible heading spans
    var questionContainers = Array.from(document.querySelectorAll('[data-params], .freebirdFormviewerViewItemsItemItem'));
    for (var qi = 0; qi < questionContainers.length; qi++) {
        var qc = questionContainers[qi];
        // Get question text
        var heading = qc.querySelector('[role="heading"], .freebirdFormviewerViewItemsItemItemTitle');
        var qText = heading ? heading.textContent.trim().toLowerCase() : '';
        if (!qText) continue;

        var inp = qc.querySelector('input[type="text"], textarea');
        if (!inp || !isFieldFillable(inp) || fillState.filledElements.has(inp)) continue;

        var val = '';
        if (/first.?name/i.test(qText)) val = firstName;
        else if (/last.?name/i.test(qText)) val = lastName;
        else if (/\bname\b/i.test(qText) && !/last|sur|family/i.test(qText)) val = fullName;
        else if (/\bemail\b/i.test(qText)) val = email;
        else if (/\bphone\b|\bmobile\b|\bcontact\b/i.test(qText)) val = phone;
        else if (AUTO_FILL_CONFIG.AI_QUESTIONS_ENABLED && isAIQuestion(qText)) {
            val = await getAIAnswer(qText, profile) || '';
        }

        if (val) {
            fillField(inp, val);
            fillState.filledElements.add(inp);
            filled++;
        }
    }

    // Fallback: any unlabeled text inputs
    var inputs = Array.from(document.querySelectorAll('input[type="text"], textarea'));
    for (var i = 0; i < inputs.length; i++) {
        var el = inputs[i];
        if (!isFieldFillable(el) || fillState.filledElements.has(el)) continue;
        var lbl = getLabelForElement(el).toLowerCase();
        var val2 = '';
        if (/first.?name/i.test(lbl)) val2 = firstName;
        else if (/last.?name/i.test(lbl)) val2 = lastName;
        else if (/\bemail\b/i.test(lbl)) val2 = email;
        else if (/\bphone\b|\bmobile\b/i.test(lbl)) val2 = phone;
        if (val2) { fillField(el, val2); fillState.filledElements.add(el); filled++; }
    }

    console.log('[AutoFill] fillGoogleForms done, filled:', filled);
    return filled;
}

// ══════════════════════════════════════════════════════════════════
// 5e. SMARTRECRUITERS FILL
// ══════════════════════════════════════════════════════════════════
async function fillSmartRecruiters(profile) {
    console.log('[AutoFill] fillSmartRecruiters start');
    var p = profile || {};
    var filled = 0;

    var firstName = (p.first_name) || (p.personal && p.personal.first_name) || '';
    var lastName  = (p.last_name)  || (p.personal && p.personal.last_name)  || '';
    var email     = (p.contact && p.contact.email) || p.email || '';
    var phone     = (p.contact && p.contact.phone) || p.phone || '';
    var city      = ((p.contact && p.contact.city) || p.city || '').split(',')[0].trim();
    var country   = (p.contact && p.contact.country) || p.country || '';
    var linkedin  = (p.social && p.social.linkedin) || p.linkedin || '';

    // SmartRecruiters may use SPL/shadow DOM components
    // Try to pierce shadow roots
    function getAllInputs(root) {
        var results = Array.from((root || document).querySelectorAll('input, textarea, select'));
        var hosts = Array.from((root || document).querySelectorAll('*'));
        hosts.forEach(function(h) {
            if (h.shadowRoot) {
                results = results.concat(getAllInputs(h.shadowRoot));
            }
        });
        return results;
    }

    var allEls = getAllInputs(document);
    var fieldMap = [
        { patterns: [/first.?name/i, /given.?name/i], value: firstName },
        { patterns: [/last.?name/i, /family.?name/i, /surname/i], value: lastName },
        { patterns: [/\bemail\b/i], value: email },
        { patterns: [/\bphone\b/i, /\bmobile\b/i, /\btel\b/i], value: phone },
        { patterns: [/\bcity\b/i, /\blocation\b/i], value: city },
        { patterns: [/\bcountry\b/i], value: country },
        { patterns: [/linkedin/i], value: linkedin }
    ];

    for (var i = 0; i < allEls.length; i++) {
        var el = allEls[i];
        if (!isFieldFillable(el) || fillState.filledElements.has(el)) continue;
        var lbl = getLabelForElement(el).toLowerCase();
        var nm  = (el.name || el.id || el.getAttribute('data-field') || '').toLowerCase();
        var combined = lbl + ' ' + nm;

        for (var fi = 0; fi < fieldMap.length; fi++) {
            var fm = fieldMap[fi];
            if (!fm.value) continue;
            if (fm.patterns.some(function(p2) { return p2.test(combined); })) {
                var tag = (el.tagName || '').toLowerCase();
                var ok = false;
                if (tag === 'select') ok = fillSelect(el, fm.value);
                else ok = fillField(el, fm.value);
                if (ok) { fillState.filledElements.add(el); filled++; }
                break;
            }
        }
    }

    if (AUTO_FILL_CONFIG.AI_QUESTIONS_ENABLED) {
        var textareas = getAllInputs(document).filter(function(e) { return e.tagName && e.tagName.toLowerCase() === 'textarea'; });
        for (var ti = 0; ti < textareas.length; ti++) {
            var ta = textareas[ti];
            if (!isFieldFillable(ta) || fillState.filledElements.has(ta)) continue;
            var taLabel = getLabelForElement(ta);
            if (taLabel && isAIQuestion(taLabel)) {
                var answer = await getAIAnswer(taLabel, profile);
                if (answer) { fillField(ta, answer); fillState.filledElements.add(ta); filled++; }
            }
        }
    }

    console.log('[AutoFill] fillSmartRecruiters done, filled:', filled);
    return filled;
}

// ══════════════════════════════════════════════════════════════════
// 5f. GENERIC FILL
// ══════════════════════════════════════════════════════════════════
async function fillGeneric(profile) {
    console.log('[AutoFill] fillGeneric start');
    var p = profile || {};
    var filled = 0;

    var firstName = (p.first_name) || (p.personal && p.personal.first_name) || '';
    var lastName  = (p.last_name)  || (p.personal && p.personal.last_name)  || '';
    var email     = (p.contact && p.contact.email) || p.email || '';
    var phone     = (p.contact && p.contact.phone) || p.phone || '';
    var city      = ((p.contact && p.contact.city) || p.city || '').split(',')[0].trim();
    var country   = (p.contact && p.contact.country) || p.country || '';
    var linkedin  = (p.social && p.social.linkedin) || p.linkedin || '';
    var portfolio = (p.social && p.social.portfolio) || p.portfolio || '';
    var github    = (p.social && p.social.github) || p.github || '';
    var fullName  = (firstName + ' ' + lastName).trim();

    var fieldRules = [
        { test: function(l,n) { return /first.?name|given.?name|fname/i.test(l+' '+n); }, value: firstName },
        { test: function(l,n) { return /last.?name|family.?name|surname|lname/i.test(l+' '+n); }, value: lastName },
        { test: function(l,n) { return /\bfull.?name\b|\byour.?name\b/i.test(l+' '+n) && !/first|last/i.test(l+' '+n); }, value: fullName },
        { test: function(l,n) { return /\bemail\b/i.test(l+' '+n); }, value: email },
        { test: function(l,n) { return /\bphone\b|\bmobile\b|\btel\b|\bcell\b/i.test(l+' '+n); }, value: phone },
        { test: function(l,n) { return /\bcity\b/i.test(l+' '+n); }, value: city },
        { test: function(l,n) { return /\bcountry\b/i.test(l+' '+n); }, value: country },
        { test: function(l,n) { return /\blocation\b|\baddress\b/i.test(l+' '+n); }, value: city },
        { test: function(l,n) { return /linkedin/i.test(l+' '+n); }, value: linkedin },
        { test: function(l,n) { return /portfolio|personal.?site|personal.?web/i.test(l+' '+n); }, value: portfolio },
        { test: function(l,n) { return /github/i.test(l+' '+n); }, value: github }
    ];

    var allEls = Array.from(document.querySelectorAll(
        'input[type="text"], input[type="email"], input[type="tel"], input[type="url"], input:not([type]), textarea, select'
    ));

    for (var i = 0; i < allEls.length; i++) {
        var el = allEls[i];
        if (!isFieldFillable(el) || fillState.filledElements.has(el)) continue;
        var lbl = getLabelForElement(el).toLowerCase();
        var nm  = (el.name || el.id || el.getAttribute('placeholder') || '').toLowerCase();
        for (var ri = 0; ri < fieldRules.length; ri++) {
            var rule = fieldRules[ri];
            if (!rule.value) continue;
            if (rule.test(lbl, nm)) {
                var tag = (el.tagName || '').toLowerCase();
                var ok = false;
                if (tag === 'select') ok = fillSelectByLabel(el, rule.value);
                else ok = fillField(el, rule.value);
                if (ok) { fillState.filledElements.add(el); filled++; }
                break;
            }
        }
    }

    if (AUTO_FILL_CONFIG.AI_QUESTIONS_ENABLED) {
        var textareas = Array.from(document.querySelectorAll('textarea'));
        for (var ti = 0; ti < textareas.length; ti++) {
            var ta = textareas[ti];
            if (!isFieldFillable(ta) || fillState.filledElements.has(ta)) continue;
            var taLabel = getLabelForElement(ta);
            if (taLabel && isAIQuestion(taLabel)) {
                var answer = await getAIAnswer(taLabel, profile);
                if (answer) { fillField(ta, answer); fillState.filledElements.add(ta); filled++; }
            }
        }
    }

    console.log('[AutoFill] fillGeneric done, filled:', filled);
    return filled;
}

// ══════════════════════════════════════════════════════════════════
// 6. FILL WORKDAY — MAIN FUNCTION
// ══════════════════════════════════════════════════════════════════
async function fillWorkday(profile) {
    console.log('[AutoFill] fillWorkday start');
    var p = profile || {};
    var filled = 0;

    // ── Extract profile data ─────────────────────────────────────
    var firstName = (p.first_name) || (p.personal && p.personal.first_name) || '';
    var middleName = (p.middle_name) || (p.personal && p.personal.middle_name) || '';
    var lastName = (p.last_name) || (p.personal && p.personal.last_name) || '';
    var phoneRaw = (p.contact && p.contact.phone) || p.phone || '';
    var address = (p.contact && p.contact.address) || p.address || '';
    var city = ((p.contact && p.contact.city) || p.city || '').split(',')[0].trim();
    var postalCode = (p.contact && p.contact.postal_code) || (p.contact && p.contact.zip_code) || p.postal_code || '';
    var country = (p.contact && p.contact.country) || p.country || '';
    var extension = (p.contact && p.contact.phone_extension) || p.extension || '';
    var hasWorkedAtWorkday = p.has_worked_at_workday === true;

    // Extract phone digits (strip country code)
    var phone = phoneRaw;
    if (phoneRaw.startsWith('+')) {
        var digits = phoneRaw.slice(1);
        if (digits.length === 12) phone = digits.slice(2);
        else if (digits.length === 11) phone = digits.slice(1);
        else if (digits.length === 13) phone = digits.slice(3);
        else phone = digits.replace(/^\d{1,3}/, '') || digits;
    }

    // Extract country code from phone (+91 → "India", +1 → "United States")
    var countryCodeMap = {
        '+1': 'United States',
        '+7': 'Russia',
        '+20': 'Egypt',
        '+27': 'South Africa',
        '+30': 'Greece',
        '+31': 'Netherlands',
        '+32': 'Belgium',
        '+33': 'France',
        '+34': 'Spain',
        '+36': 'Hungary',
        '+39': 'Italy',
        '+40': 'Romania',
        '+41': 'Switzerland',
        '+43': 'Austria',
        '+44': 'United Kingdom',
        '+45': 'Denmark',
        '+46': 'Sweden',
        '+47': 'Norway',
        '+48': 'Poland',
        '+49': 'Germany',
        '+51': 'Peru',
        '+52': 'Mexico',
        '+55': 'Brazil',
        '+56': 'Chile',
        '+60': 'Malaysia',
        '+61': 'Australia',
        '+62': 'Indonesia',
        '+63': 'Philippines',
        '+64': 'New Zealand',
        '+65': 'Singapore',
        '+66': 'Thailand',
        '+81': 'Japan',
        '+82': 'South Korea',
        '+84': 'Vietnam',
        '+86': 'China',
        '+90': 'Turkey',
        '+91': 'India',
        '+92': 'Pakistan',
        '+93': 'Afghanistan',
        '+94': 'Sri Lanka',
        '+95': 'Myanmar',
        '+98': 'Iran',
        '+212': 'Morocco',
        '+234': 'Nigeria',
        '+254': 'Kenya',
        '+971': 'United Arab Emirates'
    };

    // Derive country code from phone
    var phoneCountryCode = '';
    if (phoneRaw.startsWith('+')) {
        for (var pc in countryCodeMap) {
            if (phoneRaw.startsWith(pc)) {
                phoneCountryCode = countryCodeMap[pc];
                break;
            }
        }
    }
    // Fallback: use profile country if no phone country code found
    if (!phoneCountryCode && country) phoneCountryCode = country;

    // ── 1. FILL TEXT INPUTS BY EXACT ID ──────────────────────────
    var textFieldMap = [
        { id: 'name--legalName--firstName', v: firstName, label: 'Given Name' },
        { id: 'name--legalName--middleName', v: middleName, label: 'Middle Name' },
        { id: 'name--legalName--lastName', v: lastName, label: 'Family Name' },
        { id: 'name--legalName--firstNameLocal', v: firstName, label: 'Local Given Name' },
        { id: 'name--legalName--middleNameLocal', v: middleName, label: 'Local Middle Name' },
        { id: 'name--legalName--lastNameLocal', v: lastName, label: 'Local Family Name' },
        { id: 'address--addressLine1', v: address, label: 'Address Line 1' },
        { id: 'address--city', v: city, label: 'City' },
        { id: 'address--postalCode', v: postalCode, label: 'Postal Code' },
        { id: 'phoneNumber--phoneNumber', v: phone, label: 'Phone Number' },
        { id: 'phoneNumber--extension', v: extension, label: 'Extension' }
    ];

    for (var ti = 0; ti < textFieldMap.length; ti++) {
        var tfm = textFieldMap[ti];
        if (!tfm.v) continue;
        var el = document.getElementById(tfm.id);
        if (el && isFieldFillable(el) && !fillState.filledElements.has(el)) {
            if (fillField(el, tfm.v)) {
                fillState.filledElements.add(el);
                filled++;
                console.log('[WD] text filled:', tfm.label, '=', tfm.v.substring(0, 40));
            }
        }
        await delay(80);
    }

    // ── 2. PHONE COUNTRY CODE (searchable input) ──────────────────
    // Input id=phoneNumber--countryPhoneCode, placeholder="Search"
    // User types country name to filter, React Select shows options
    async function fillPhoneCountryCode(desiredCountry) {
        var ccInput = document.getElementById('phoneNumber--countryPhoneCode');
        if (!ccInput || !isFieldFillable(ccInput) || fillState.filledElements.has(ccInput)) return false;
        if (!desiredCountry) return false;

        ccInput.click();
        ccInput.focus();
        await delay(150);

        // Type country name char-by-char
        var ns3 = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
        var cur3 = '';
        for (var ci4 = 0; ci4 < desiredCountry.length; ci4++) {
            var ch4 = desiredCountry[ci4];
            var kc4 = ch4.charCodeAt(0);
            cur3 += ch4;
            ccInput.dispatchEvent(new KeyboardEvent('keydown', {key:ch4, keyCode:kc4, which:kc4, bubbles:true}));
            if (ns3) ns3.call(ccInput, cur3); else ccInput.value = cur3;
            ccInput.dispatchEvent(new InputEvent('input', {bubbles:true, inputType:'insertText', data:ch4}));
            ccInput.dispatchEvent(new KeyboardEvent('keyup', {key:ch4, keyCode:kc4, which:kc4, bubbles:true}));
            await delay(40);
        }

        // Press Enter to trigger search/filter
        ccInput.dispatchEvent(new KeyboardEvent('keydown', {key:'Enter', keyCode:13, bubbles:true}));
        ccInput.dispatchEvent(new KeyboardEvent('keyup', {key:'Enter', keyCode:13, bubbles:true}));
        await delay(800);

        // Find the radio button by checking parent container text for country name + code
        var allRadios = Array.from(document.querySelectorAll('input[type="radio"]')).filter(function(r){
            var rect = r.getBoundingClientRect();
            return rect.height > 0 && rect.width > 0;
        });

        var targetRadio = allRadios.find(function(r){
            var closest = r.closest('div[role="option"], div[class*="option"]');
            if(!closest) return false;
            var text = closest.textContent.toLowerCase();
            return text.includes(desiredCountry.toLowerCase());
        });

        if (targetRadio) {
            targetRadio.click();
            targetRadio.dispatchEvent(new Event('change', {bubbles:true}));
            filled++;
            fillState.filledElements.add(ccInput);
            console.log('[WD] Phone country set:', desiredCountry);
            await delay(200);
            return true;
        }

        console.log('[WD] Phone country code not found:', desiredCountry);
        document.body.click();
        return false;
    }

    await fillPhoneCountryCode(phoneCountryCode);
    await delay(200);

    // ── 3. COUNTRY / TERRITORY DROPDOWN ──────────────────────────
    // Similar to Greenhouse: mousedown+mouseup+click on control, then search/filter
    async function fillCountrySelect(desiredCountry) {
        var countrySelect = document.querySelector('#country--country, [aria-label*="Country"], [aria-label*="Territory"]');
        if (!countrySelect || fillState.filledElements.has(countrySelect)) return false;

        // If no specific country, use the one from profile
        if (!desiredCountry) desiredCountry = country || 'India';

        // Find the select control/container
        var cont = countrySelect.tagName === 'SELECT' ? countrySelect
                 : countrySelect.closest('[class*="select"], div[role="combobox"], div[role="button"]');
        if (!cont) return false;

        var control = cont.querySelector('[class*="select__control"]') || cont;
        var inp4 = cont.querySelector('input');
        if (!inp4) return false;

        var rect = control.getBoundingClientRect();
        control.dispatchEvent(new MouseEvent('mousedown', {bubbles:true, cancelable:true, view:window, clientX:rect.left+10, clientY:rect.top+10}));
        control.dispatchEvent(new MouseEvent('mouseup', {bubbles:true, cancelable:true, view:window, clientX:rect.left+10, clientY:rect.top+10}));
        control.dispatchEvent(new MouseEvent('click', {bubbles:true, cancelable:true, view:window, clientX:rect.left+10, clientY:rect.top+10}));
        await delay(400);

        // Type to search
        var ns4 = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
        inp4.focus();
        var cur4 = '';
        for (var ci5 = 0; ci5 < desiredCountry.length; ci5++) {
            var ch5 = desiredCountry[ci5];
            var kc5 = ch5.charCodeAt(0);
            cur4 += ch5;
            inp4.dispatchEvent(new KeyboardEvent('keydown', {key:ch5, keyCode:kc5, which:kc5, bubbles:true}));
            if (ns4) ns4.call(inp4, cur4); else inp4.value = cur4;
            inp4.dispatchEvent(new InputEvent('input', {bubbles:true, inputType:'insertText', data:ch5}));
            inp4.dispatchEvent(new KeyboardEvent('keyup', {key:ch5, keyCode:kc5, which:kc5, bubbles:true}));
            await delay(40);
        }
        await delay(600);

        var opts4 = Array.from(document.querySelectorAll('[class*="select__option"], [role="option"]')).filter(function(o) {
            var r = o.getBoundingClientRect(); return r.width > 0 && r.height > 0;
        });
        if (opts4.length === 0) {
            console.log('[WD] No country options');
            document.body.click();
            return false;
        }

        var desired4 = desiredCountry.toLowerCase();
        var target4 = opts4.find(function(o) { return o.textContent.trim().toLowerCase() === desired4; })
                   || opts4.find(function(o) { return o.textContent.trim().toLowerCase().startsWith(desired4); })
                   || opts4.find(function(o) { return o.textContent.trim().toLowerCase().includes(desired4); });
        if (target4) {
            target4.click();
            filled++;
            fillState.filledElements.add(cont);
            console.log('[WD] Country set:', target4.textContent.trim());
            await delay(200);
            return true;
        }
        document.body.click();
        return false;
    }

    await fillCountrySelect(country);
    await delay(200);

    // ── 4. PREVIOUS WORKER RADIO BUTTON ──────────────────────────
    // candidateIsPreviousWorker: true=Yes, false=No
    var radioPreviousWorker = hasWorkedAtWorkday ? 'tv5q3' : 'tv5q4';  // tv5q3=Yes, tv5q4=No
    var rb = document.getElementById(radioPreviousWorker);
    if (rb && !rb.checked && !fillState.filledElements.has(rb)) {
        rb.click();
        rb.dispatchEvent(new Event('change', {bubbles:true}));
        filled++;
        fillState.filledElements.add(rb);
        console.log('[WD] Previous worker radio:', hasWorkedAtWorkday ? 'Yes' : 'No');
    }
    await delay(100);

    console.log('[AutoFill] fillWorkday done, filled:', filled);
    return filled;
}
async function fillLinkedIn(profile) {
    console.log('[AutoFill] fillLinkedIn start');
    var p = profile || {};
    var filled = 0;

    var firstName = (p.first_name) || (p.personal && p.personal.first_name) || '';
    var lastName  = (p.last_name)  || (p.personal && p.personal.last_name)  || '';
    var email     = (p.contact && p.contact.email) || p.email || '';
    var phone     = (p.contact && p.contact.phone) || p.phone || '';
    var city      = ((p.contact && p.contact.city) || p.city || '').split(',')[0].trim();

    var fieldMap = [
        { selector: 'input[name="firstName"], input[id*="first"][type="text"]', value: firstName },
        { selector: 'input[name="lastName"], input[id*="last"][type="text"]', value: lastName },
        { selector: 'input[name="email"], input[type="email"]', value: email },
        { selector: 'input[name="phone"], input[type="tel"]', value: phone },
        { selector: 'input[name="city"], input[placeholder*="City"]', value: city }
    ];

    for (var fi = 0; fi < fieldMap.length; fi++) {
        var fm = fieldMap[fi];
        if (!fm.value) continue;
        var el = document.querySelector(fm.selector);
        if (el && isFieldFillable(el) && !fillState.filledElements.has(el)) {
            fillField(el, fm.value);
            fillState.filledElements.add(el);
            filled++;
        }
    }

    // Generic fallback
    var allInps = Array.from(document.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"], textarea'));
    for (var i = 0; i < allInps.length; i++) {
        var inp = allInps[i];
        if (!isFieldFillable(inp) || fillState.filledElements.has(inp)) continue;
        var lbl = getLabelForElement(inp).toLowerCase();
        var val = '';
        if (/first.?name/i.test(lbl)) val = firstName;
        else if (/last.?name/i.test(lbl)) val = lastName;
        else if (/\bemail\b/i.test(lbl)) val = email;
        else if (/\bphone\b|\bmobile\b/i.test(lbl)) val = phone;
        else if (/\bcity\b|\blocation\b/i.test(lbl)) val = city;
        if (val) { fillField(inp, val); fillState.filledElements.add(inp); filled++; }
    }

    if (AUTO_FILL_CONFIG.AI_QUESTIONS_ENABLED) {
        var textareas = Array.from(document.querySelectorAll('textarea'));
        for (var ti = 0; ti < textareas.length; ti++) {
            var ta = textareas[ti];
            if (!isFieldFillable(ta) || fillState.filledElements.has(ta)) continue;
            var taLabel = getLabelForElement(ta);
            if (taLabel && isAIQuestion(taLabel)) {
                var answer = await getAIAnswer(taLabel, profile);
                if (answer) { fillField(ta, answer); fillState.filledElements.add(ta); filled++; }
            }
        }
    }

    console.log('[AutoFill] fillLinkedIn done, filled:', filled);
    return filled;
}

// ══════════════════════════════════════════════════════════════════
// 7. PLATFORM DISPATCHER
// ══════════════════════════════════════════════════════════════════
async function applyPlatformFixes(platform, profile) {
    console.log('[AutoFill] applyPlatformFixes — platform:', platform);
    fillState.isFilling = true;
    fillState.filledElements = new Set(); // reset per-fill

    var filled = 0;
    try {
        switch (platform) {
            case 'workday':
                filled = await fillWorkday(profile);
                break;
            case 'greenhouse':
                filled = await fillGreenhouse(profile);
                break;
            case 'lever':
                filled = await fillLever(profile);
                break;
            case 'ashby':
                filled = await fillAshby(profile);
                break;
            case 'googleforms':
                filled = await fillGoogleForms(profile);
                break;
            case 'smartrecruiters':
                filled = await fillSmartRecruiters(profile);
                break;
            case 'linkedin':
                filled = await fillLinkedIn(profile);
                break;
            case 'indeed':
                filled = await fillGeneric(profile);
                break;
            case 'generic':
            default:
                filled = await fillGeneric(profile);
                break;
        }
        var msg = '[AutoFill] Done — platform: ' + platform + ', fields filled: ' + filled;
        console.log(msg);
        showToast('AutoFill complete: ' + filled + ' field(s) filled.', 'success');
    } catch (err) {
        console.error('[AutoFill] applyPlatformFixes error:', err);
        showToast('AutoFill error: ' + err.message, 'error');
    } finally {
        fillState.isFilling = false;
    }
    return filled;
}

// ══════════════════════════════════════════════════════════════════
// 8. MESSAGE LISTENER
// ══════════════════════════════════════════════════════════════════
chrome.runtime.onMessage.addListener(function(message, sender, sendResponse) {
    if (!message || !message.type) return false;

    // Handle all autofill trigger types
    // PERFORM_AUTO_FILL = from background.js RUN_AUTOFILL (main flow)
    // AUTOFILL_START / AUTO_FILL_FORM = legacy / direct calls
    if (message.type === 'PERFORM_AUTO_FILL' ||
        message.type === 'AUTOFILL_START' ||
        message.type === 'AUTO_FILL_FORM') {

        console.log('[AutoFill] Fill request:', message.type);

        if (fillState.isFilling) {
            sendResponse({ success: false, error: 'Already filling' });
            return false;
        }

        // PERFORM_AUTO_FILL sends userProfile; others send profile/data
        var profile = message.userProfile || message.profile || message.data || null;
        var platform = message.platform || detectPlatform();

        // Update backend URL if provided
        if (message.backendUrl) {
            AUTO_FILL_CONFIG.BACKEND_URL = message.backendUrl;
            fillState.backendUrl = message.backendUrl;
        }

        fillState.platform = platform;
        fillState.userProfile = profile;

        function doFill(p) {
            console.log('[AutoFill] Starting — platform:', platform,
                        '| name:', (p && (p.name || p.first_name)) || 'unknown');
            showToast('AutoFill starting...', 'success');
            applyPlatformFixes(platform, p)
                .then(function(filled) {
                    try {
                        sendResponse({
                            success: true,
                            filled: filled,
                            result: { filledCount: filled, skippedCount: 0 }
                        });
                    } catch(e) {}
                })
                .catch(function(err) {
                    try { sendResponse({ success: false, error: err.message }); } catch(e) {}
                });
        }

        if (!profile) {
            // Try loading from chrome.storage (background may not pass profile)
            try {
                chrome.storage.local.get(['userProfile'], function(r) {
                    var sp = r && r.userProfile;
                    if (!sp) {
                        sendResponse({
                            success: false,
                            error: 'No profile loaded. Please upload your resume first.'
                        });
                        return;
                    }
                    fillState.userProfile = sp;
                    doFill(sp);
                });
                return true;
            } catch(e2) {
                sendResponse({ success: false, error: 'No profile: ' + e2.message });
                return false;
            }
        }

        doFill(profile);
        return true;
    }

    if (message.type === 'GET_FILL_STATE') {
        sendResponse({
            success: true,
            isFilling: fillState.isFilling,
            platform: fillState.platform || detectPlatform()
        });
        return false;
    }

    if (message.type === 'DETECT_PLATFORM') {
        sendResponse({ success: true, platform: detectPlatform() });
        return false;
    }

    if (message.type === 'PING') {
        sendResponse({ alive: true, platform: detectPlatform() });
        return false;
    }

    return false;
});

console.log('[AutoFill] content script initialized — platform:', detectPlatform());

} // end else (window.__autoFillInitialized guard)
