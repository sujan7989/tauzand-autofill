# Flask Configuration
FLASK_APP=main.py
FLASK_ENV=development
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database Configuration (for future milestones)
DATABASE_URL=sqlite:///app.db

# Supabase Configuration
SUPABASE_URL=your-supabase-url-here
SUPABASE_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (for backend-only operations)
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# NVIDIA NIM (AI field mapping & answer generation)
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=mistralai/mistral-medium-3.5-128b

# AI model parameters (optional — defaults shown)
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3
AI_TOP_P=0.9
AI_CACHE_TTL=3600
AI_REQUEST_TIMEOUT=30.0